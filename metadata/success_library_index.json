    {
      "metric_id": "VVD_USG_001",
      "metric_name": "Card Usage",
      "product": "VVD",
      "line_of_business": "Debit Cards",
      "metric_type": "Usage",
      "pillar": "Engagement",
      "business_definition": "Client used their VVD card for a transaction. Captures point-of-sale transactions with specific transaction types (10/0210, 13/0210, 12/0220) where amount > 0.",
      "code_path": "code/VVD/VVD_USG_001.md",
      "source_tables": ["DDWTA_T_PT_OF_SALE_TXN"],
      "staged_source": "",
      "grain": "Client",
      "owner": "Marketing Analytics",
      "version": "v1.0",
      "campaigns_using": ["VUI", "VUT", "VAW"],
      "technical": {
        "source": "HIVE",
        "table_path": "/prod/sz/tsz/00050/data/DDWTA_T_PT_OF_SALE_TXN/SNAP_DT=",
        "date_field": "TXN_DT",
        "client_field": "CLNT_NO",
        "partition_field": "SNAP_DT",
        "filters": {
          "SRVC_CD": 36,
          "TXN_TYPES": [
            {"TXN_TP": 10, "MSG_TP": "0210"},
            {"TXN_TP": 13, "MSG_TP": "0210"},
            {"TXN_TP": 12, "MSG_TP": "0220"}
          ],
          "AMT1_GT": 0,
          "EXTRACT_CLNT_NO": true
        },
        "add_card_type": false,
        "client_extraction_logic": "SUBSTR(CLNT_CRD_NO, 7, 9) with leading zeros removed"
      },
      "measurement": {
        "default_window_days": 90,
        "attribution_model": "FIRST_TOUCH"
      },
      "governance": {
        "status": "ACTIVE",
        "last_validated": "2026-01-24"
      }
    },
    {
      "metric_id": "VVD_PRV_001",
      "metric_name": "Wallet Provisioning",
      "product": "VVD",
      "line_of_business": "Debit Cards",
      "metric_type": "Provisioning",
      "pillar": "Conversion",
      "business_definition": "Client provisioned their VVD card to a digital wallet (Apple Pay, Google Pay, etc.). Identified by token registration with wallet indicator.",
      "code_path": "code/VVD/VVD_PRV_001.md",
      "source_tables": ["DDWV05.CLNT_CRD_POS_LOG", "DL_DECMAN.TOKEN_LIST"],
      "staged_source": "",
      "grain": "Client",
      "owner": "Marketing Analytics",
      "version": "v1.0",
      "campaigns_using": ["VAW", "VUI", "VUT"],
      "technical": {
        "source": "EDW",
        "table_path": null,
        "date_field": "TXN_DT",
        "client_field": "CLNT_NO",
        "filters": {
          "AMT1": 0,
          "CLNT_CRD_NO_PREFIX": "45190",
          "VISA_DR_CRD_NO_PREFIX": "45199",
          "TOKN_REQSTR_ID_NOT_ZERO": true,
          "POS_ENTR_MODE_CD_NON_EMV": "000",
          "SRVC_CD": 36,
          "TOKEN_WALLET_IND": "Y"
        },
        "add_card_type": false,
        "client_extraction_logic": "SUBSTR(CLNT_CRD_NO, 7, 9) cast to integer"
      },
      "measurement": {
        "default_window_days": 90,
        "attribution_model": "FIRST_TOUCH"
      },
      "governance": {
        "status": "ACTIVE",
        "last_validated": "2026-01-24"
      }
    },
