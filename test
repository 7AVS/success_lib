Get-Content "$HOME\Desktop\mnemonic_matches.txt" |
  ForEach-Object {
    if ($_ -match '^(.+?):(\d+):(.+)$') {
      [PSCustomObject]@{
        File = $Matches[1]
        Line = $Matches[2]
        Content = $Matches[3]
      }
    }
  } | Export-Csv "$HOME\Desktop\mnemonic_matches.csv" -NoTypeInformation