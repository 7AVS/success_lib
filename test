# Compile the regex once upfront — avoids recompiling per file
$regex = [regex]::new("FTH|MOM|BOL|ESV|GIS|LTA|RCL|RCU|VBA|CTU|MRF|NMI|PCD|PCL|PCQ|PPQ|TFP|VBU|RIS|TAO|RMG|VCN|IRI|O2P|CRV|EBR|IDE|RPB|ZRR|PFS|PRA|DAR|VSX|RCR|COB|VAW|GNE|COR|VUI|PVE|MOS|RAT|MFY|MMT|IFC", "Compiled, IgnoreCase")

$searchPath = "\\maple.fg.rbc.com\data\Toronto\wrkgrp\wrkgrp16\Marketing Services & Transformation\Marketing Analytics"
$outFile = "$HOME\Desktop\sas_mnemonic_files.csv"

Get-ChildItem -LiteralPath $searchPath -Filter "*.sas" -Recurse -File -ErrorAction SilentlyContinue |
  Select-String -Pattern $regex -List -ErrorAction SilentlyContinue |
  Select-Object @{N='FileName';E={$_.Filename}}, @{N='FolderPath';E={$_.Path | Split-Path}}, @{N='FullPath';E={$_.Path}} |
  Export-Csv -LiteralPath $outFile -NoTypeInformation