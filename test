$files = Import-Csv "$HOME\Desktop\sas_mnemonic_files.csv"

$narrowed = $files | Where-Object {
    $content = Get-Content -LiteralPath $_.FullPath -Raw -ErrorAction SilentlyContinue
    $content -match "(?i)success"
}

$narrowed | Export-Csv "$HOME\Desktop\sas_success.csv" -NoTypeInformation
Write-Host "Narrowed from $($files.Count) to $($narrowed.Count) files"